+		"$DSATEST" -w 0 -l 4096 -f 0x1 -o 0x1 -b 0x3 -c 2 "${VERBOSE}" &&
 			echo "shoudl fail, but pass" && exit 1
 		"$ACCFG" disable-device $DSA
 
